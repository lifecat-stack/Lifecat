# Lifecat reference environment
# Copy only the variables required by the specific module you are running.

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=lifecat
MYSQL_USER=<your-mysql-user>
MYSQL_PASSWORD=<your-mysql-password>

SERVER_PORT=8080

# Optional object storage / upload path used by historical modules.
UPLOAD_ROOT=<local-upload-directory>
